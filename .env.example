# Copy to .env and fill in DPLA_API_KEY. The other settings are optional.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/dpla-catalog-mcp`.
# Variables already set in the environment take precedence.
#
# .env is git-ignored. Never commit a key, and never pass it as a tool argument.

# Required: your DPLA API key, 32 letters, digits or hyphens. It is free:
#   curl -X POST https://api.dp.la/v2/api_key/you@example.org
# and DPLA emails it to that address.
DPLA_API_KEY=your-key-here

# Optional: directory for the on-disk response cache.
# DPLA_CACHE_DIR=~/.cache/dpla-catalog-mcp

# Optional: HTTP timeout in seconds (default 30).
# DPLA_TIMEOUT=30

# Optional: least seconds between requests to DPLA (default 0.25).
# DPLA_MIN_INTERVAL=0.25
